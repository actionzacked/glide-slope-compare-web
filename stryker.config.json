{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/glide/**/*.ts",
    "!src/glide/**/*.test.ts",
    "!src/glide/tolerances.ts"
  ],
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "clearTextReporter": {
    "reportTests": false
  }
}
